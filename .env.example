# docker compose 用。実値は VPS の /opt/sakuden-schedulemate/.env に置く（コミットしない）
DASHBOARD_API_BASE=http://sd-api:8000/api
CHAIRMAN_STAFF_ID=S006
CHAIRMAN_NAME=会長
LIVE_MODEL=gpt-live-1
AGENT_MODEL=gpt-5.6-luna
VOICE_NAME=marin
VOICE_DAILY_LIMIT_MIN=60
VOICE_SESSION_MAX_MIN=10
VOICE_DEBUG_TEXT=false
# OpenAI の API キーは環境変数ではなくファイルで渡す: ./secrets/openai_api_key

# === 公開（docker-compose.prod.yml 用） ===
# 配布リンクのアクセスキー: ラベル:キー,ラベル:キー（キーは英数字と _- で 24 文字以上）
APP_ACCESS_KEYS=
# Cloudflare Tunnel のコネクタトークン（Zero Trust → Networks → Tunnels）
TUNNEL_TOKEN=
# 所在ダッシュボード側 APP_ACCESS_KEYS のうち 1 本（ラベル無しのキー値だけ）
DASHBOARD_API_KEY=
